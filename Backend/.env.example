# ==========================================
# RAZORPAY CONFIGURATION (TEST MODE)
# ==========================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret

# ==========================================
# POSTGRESQL DATABASE CONFIGURATION
# ==========================================
# Option A: Local Development (Default)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/legalconnect
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=root

# Option B: Neon PostgreSQL (Production)
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxxx.ap-southeast-1.aws.neon.tech/legalconnect?sslmode=require
# SPRING_DATASOURCE_USERNAME=legalconnect_owner
# SPRING_DATASOURCE_PASSWORD=your_neon_password

# ==========================================
# JWT CONFIGURATION
# ==========================================
JWT_SECRET=your_256_bit_jwt_secret_base64_encoded_here

# ==========================================
# PRODUCTION PROFILE (OPTIONAL)
# ==========================================
# SPRING_PROFILES_ACTIVE=prod
# APP_CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
